---
import { projects } from '../../data/portfolio';
import ProjectPreview from '../ProjectPreview.astro';
---
<div class="section-intro"><p>Things I wanted to exist, so I built them.<br />Local-first apps for work, money and everyday life.</p><span class="section-aside">FOUR PROJECTS · ALL SHIPPED</span></div>
<div class="projects-grid">
  {projects.map((project, index) => <article class:list={['project-card', `project-${project.id}`]}>
    <ProjectPreview kind={project.id} />
    <div class="project-body">
      <div class="project-meta"><span>{project.category}</span><span class="shipped"><span class="status-dot"></span>Shipped</span></div>
      <div class="project-title"><h3>{project.name}</h3>{'repo' in project && <a class="project-repo" href={project.repo} target="_blank" rel="noreferrer" aria-label={`${project.name} source on GitHub`}>↗</a>}</div>
      <p>{project.description}</p>
      <div class="tech-tags">{project.tech.map(tech => <span>{tech}</span>)}</div>
      <details><summary>Under the hood <span class="disclosure-plus" aria-hidden="true">+</span></summary><div class="project-details">{project.details.map(detail => <p>{detail}</p>)}{!('repo' in project) && <p class="private-note">Private repository.</p>}</div></details>
      <span class="project-index" aria-hidden="true">0{index + 1}</span>
    </div>
  </article>)}
</div>
