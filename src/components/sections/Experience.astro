---
import { experiences } from '../../data/portfolio';
import { profile } from '../../data/portfolio';
---
<div class="experience-grid">
  <div class="experience-note"><p>I like being close to the problem, the people and the product.</p><p>Nearly five years of building, collaborating and taking responsibility for what ships.</p><a class="text-link" href={profile.resume} target="_blank" rel="noreferrer">The full story in my résumé <span aria-hidden="true">↗</span></a></div>
  <div class="experience-list">{experiences.map(entry => <article class="experience-entry"><div class="experience-date"><span>{entry.period}</span>{entry.current && <span class="current-label">NOW</span>}</div><h3>{entry.role}</h3><p class="company-name">{entry.company}</p><p class="experience-description">{entry.description}</p><p class="experience-progression">{entry.note}</p><div class="tech-tags">{entry.tags.map(tag => <span>{tag}</span>)}</div></article>)}</div>
</div>
