---
import { profile, capabilities } from '../data/portfolio';
import SectionRail from './SectionRail.astro';
---

<section class="section" id="about">
  <SectionRail label="About" />
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">What I do</span>
      <h2>Full-stack engineer who owns products <span class="accent">end to end</span>.</h2>
      <p>
        I take a product from the first client conversation to production, in whichever layer the
        problem lives. Five areas I can own, each with one piece of proof:
      </p>
    </div>

    <ul class="cap-grid">
      {
        capabilities.map((c, i) => (
          <li class="card cap-card reveal" data-delay={String((i % 3) + 1)}>
            <span class="cap-ic"><svg class="ic" data-lucide={c.icon}></svg></span>
            <h3 class="cap-title">{c.title}</h3>
            <p class="cap-proof">{c.proof}</p>
          </li>
        ))
      }
    </ul>

    <div class="about-grid">
      <div class="about-bio reveal" data-delay="1">
        <p>
          I work mainly in TypeScript: <b>React and Next.js</b> interfaces, <b>Node.js APIs</b> with
          <b>PostgreSQL and SQLite</b> behind them, and Docker, Nginx and GitHub Actions to ship. At
          <b>LYIK Technologies</b>, where I was recently promoted to Senior Engineer, I started v1
          of the forms platform, led the v2 rewrite, and now build v3.
        </p>
        <p>
          The part I care about most is ownership: <b>gathering requirements directly from
          customers</b>, aligning backend, QA and product, and <b>mentoring</b> the people who build
          on top of my work. Outside work I ship local-first desktop and mobile apps, and I am
          building a central authentication service on ZITADEL and PostgreSQL.
        </p>
      </div>

      <div class="about-side">
        <div class="stat-card reveal" data-delay="2">
          <div class="stat-num">30%+</div>
          <div class="stat-label">efficiency gains delivered through client-facing platform development</div>
        </div>
        <div class="card fact-card reveal" data-delay="3">
          <div class="fc-label"><svg class="ic" data-lucide="graduation-cap"></svg> Education</div>
          <div class="fc-value">{profile.education} — {profile.educationSchool}</div>
        </div>
        <div class="card fact-card reveal" data-delay="3">
          <div class="fc-label"><svg class="ic" data-lucide="languages"></svg> Languages</div>
          <div class="chip-row">
            {profile.languages.map((l) => <span class="chip">{l}</span>)}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
