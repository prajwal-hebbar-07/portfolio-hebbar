---
import { selectedWork, projects } from '../data/portfolio';
import Icon from './Icon.astro';

const [featured, ...cards] = selectedWork;
const shipped = projects.filter((p) => !p.selected);
---

<section id="work" class="split">
  <h2 class="label">02 — Selected work</h2>
  <div class="split-body stack-16">
    <article class="card">
      <div class="meta upper row-between">
        <span>{featured.label}</span><span>{featured.meta}</span>
      </div>
      <h3 class="card-title lg">{featured.title}</h3>
      <p class="card-text">{featured.text}</p>
      <ul class="tags">
        {featured.tags.map((t) => <li>{t}</li>)}
      </ul>
    </article>

    <div class="card-grid">
      {
        cards.map((c) => (
          <article class="card">
            <span class="meta upper">{c.label}</span>
            <h3 class="card-title">{c.title}</h3>
            <p class="card-text">{c.text}</p>
            <p class="meta card-foot">{c.tags.join(' · ')}</p>
          </article>
        ))
      }
    </div>

    <div class="shipped">
      <p class="meta upper">Also shipped</p>
      <ul>
        {
          shipped.map((p) => {
            const Tag = p.repo ? 'a' : 'div';
            return (
              <li>
                <Tag class="row" href={p.repo} target={p.repo ? '_blank' : undefined} rel={p.repo ? 'noopener' : undefined}>
                  <span class="name">{p.name}</span>
                  <span class="desc">{p.tagline}</span>
                  {p.repo && <Icon name="arrow-up-right" size={16} />}
                </Tag>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>
