---
import { RESUME_URL, site } from '../config/site';

const [first, ...rest] = site.sections;
---

<header class="nav">
  <div class="wrap nav-in">
    <a class="brand" href={`#${first.id}`} aria-label="Prajwal Hebbar, top of page">
      <span class="brand-mark" aria-hidden="true">PH</span>prajwal.hebbar
    </a>

    <nav class="nav-links" aria-label="Sections">
      {rest.map((s) => <a href={`#${s.id}`} data-order-item={s.id}>{s.label.toLowerCase()}</a>)}
    </nav>

    <div class="nav-tools">
      <button class="tool tool-wide" type="button" id="schema-all" aria-pressed="false" title="Show every section's config">
        {'{ }'} all
      </button>
      <button class="tool" type="button" data-open-editor aria-haspopup="dialog">config</button>
      <button class="tool tool-sq" type="button" id="theme-toggle" aria-label="Switch between light and dark theme">◐</button>
      <a class="tool" href={RESUME_URL} target="_blank" rel="noopener" aria-label="Résumé (PDF)">résumé ↓</a>
    </div>
  </div>
</header>
