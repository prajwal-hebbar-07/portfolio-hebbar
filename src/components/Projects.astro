---
import { projects } from '../data/portfolio';
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="section" id="projects">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Projects</span>
      <h2>Local-first desktop software, <span class="accent">built to last.</span></h2>
    </div>

    <div class="projects">
      {
        projects.map((project, index) => (
          <article class="pj reveal" data-delay="1">
            <span class="pj-index" aria-hidden="true">{pad(index + 1)}</span>
            <div class="card pj-card">
              <div class="pj-summary">
                <h3 class="pj-name">{project.name}</h3>
                <a
                  class="pj-repo"
                  href={project.repo}
                  target="_blank"
                  rel="noopener"
                  aria-label={`${project.name} source on GitHub — ${project.repoLabel}`}
                >
                  <svg class="ic" data-lucide="github"></svg>
                  <span class="pj-repo-label">{project.repoLabel}</span>
                  <svg class="ic pj-repo-out" data-lucide="arrow-up-right"></svg>
                </a>
                <p class="pj-tagline">{project.tagline}</p>
                <span class:list={['pj-status', project.shipped && 'is-shipped']}>{project.status}</span>
                <div class="pj-kind">{project.kind}</div>
              </div>

              <div class="pj-body">
                <ul class="xp-points">
                  {project.points.map((point) => <li set:html={point} />)}
                </ul>

                <div class="tech-row" aria-label="Technologies used">
                  {project.tech.map((technology) => <span class="tech-tag">{technology}</span>)}
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
