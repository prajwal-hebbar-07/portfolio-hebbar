---
import { profile } from '../data/portfolio';
import Icon from './Icon.astro';

const links = [
  { href: '#experience', label: 'Experience' },
  { href: '#work', label: 'Work' },
  { href: '#stack', label: 'Stack' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="header">
  <a class="brand" href="#top" aria-label={`${profile.name} — home`}>
    <span class="mark" aria-hidden="true">PH</span>
    <span>{profile.name}</span>
  </a>
  <nav class="nav" aria-label="Primary">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
    <a class="pill-link" href="/Prajwal%20Hebbar%20-%20Resume.pdf" target="_blank" rel="noopener">
      Résumé <Icon name="download" />
    </a>
    <button class="theme-btn" id="theme-toggle" type="button" aria-label="Toggle light and dark theme">
      <Icon name="contrast" size={16} />
    </button>
  </nav>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const dark = matchMedia('(prefers-color-scheme: dark)').matches;
    const current = root.dataset.theme ?? (dark ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('ph_theme', next);
    } catch {}
  });
</script>
