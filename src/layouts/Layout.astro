---
import '../styles/tokens.css';
import '../styles/portfolio.css';
import '../styles/personalize.css';
import { profile } from '../data/portfolio';

const title = `${profile.name} — ${profile.role}`;
const description = `${profile.name} — ${profile.role} building configurable, enterprise-grade web platforms with React, TypeScript, and thoughtful design systems. Based in ${profile.location}.`;
---

<!DOCTYPE html>
<html lang="en" data-theme="dark" data-accent="verdigris" data-font="grotesk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* Pre-paint personalization. Must stay inline and non-module so it runs
        before first paint — a deferred module would show the default theme,
        accent and section order for a frame first. Mirrors read()/normalize()
        in src/data/personalize.ts; keep the key and attribute names in sync. */}
    <script is:inline>
      (function () {
        var KEY = 'ph_personalize';
        var LEGACY = 'ph_theme';
        var IDS = ['hero', 'about', 'experience', 'projects', 'skills', 'contact'];
        var d = document.documentElement;
        var s = null;
        try {
          s = JSON.parse(localStorage.getItem(KEY) || 'null');
        } catch (e) {}
        if (typeof s !== 'object' || s === null) s = {};

        var theme = s.theme === 'light' || s.theme === 'dark' ? s.theme : null;
        if (!theme) {
          try {
            var old = localStorage.getItem(LEGACY);
            if (old === 'light' || old === 'dark') theme = old;
          } catch (e) {}
        }
        if (!theme) {
          theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        d.setAttribute('data-theme', theme);
        if (typeof s.accent === 'string') d.setAttribute('data-accent', s.accent);
        if (typeof s.font === 'string') d.setAttribute('data-font', s.font);
        if (s.accent === 'custom' && typeof s.seed === 'string') {
          d.style.setProperty('--accent-seed', s.seed);
        }

        var raw = Array.isArray(s.order) ? s.order : [];
        var order = [];
        for (var i = 0; i < raw.length; i++) {
          if (IDS.indexOf(raw[i]) !== -1 && order.indexOf(raw[i]) === -1) order.push(raw[i]);
        }
        for (var j = 0; j < IDS.length; j++) {
          if (order.indexOf(IDS[j]) === -1) order.push(IDS[j]);
        }

        var css = '#sections{display:flex;flex-direction:column}';
        var n = 0;
        for (var k = 0; k < order.length; k++) {
          css += '#sections>#' + order[k] + '{order:' + k + '}';
          if (order[k] === 'hero') continue;
          n += 1;
          css +=
            '.nav-links a[href="#' + order[k] + '"],.mobile-menu a[href="#' + order[k] +
            '"]{order:' + n + '}';
        }
        var st = document.createElement('style');
        st.id = 'pz-boot';
        st.textContent = css;
        document.head.appendChild(st);
      })();
    </script>
  </head>
  <body>
    <slot />

    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js" is:inline></script>
    <script>
      import '../scripts/app.ts';
    </script>
  </body>
</html>
