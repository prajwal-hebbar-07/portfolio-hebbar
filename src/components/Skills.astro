---
import { skillGroups } from '../data/portfolio';
import SectionRail from './SectionRail.astro';
---

<section class="section" id="skills">
  <SectionRail label="Skills" />
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Skills</span>
      <h2>The stack behind <span class="accent">configurable</span> systems.</h2>
    </div>

    <div class="skills-grid">
      {
        skillGroups.map((g, i) => (
          <div
            class={`card skill-card${g.alt ? ' alt' : ''} reveal`}
            data-delay={i % 2 === 0 ? '1' : '2'}
            style={g.full ? 'grid-column:1/-1;' : undefined}
          >
            <div class="sk-head">
              <span class="sk-ic"><svg class="ic" data-lucide={g.icon}></svg></span>
              <span class="sk-title">{g.title}</span>
            </div>
            <div class="skill-tags">
              {g.skills.map((s) => <span class="chip">{s}</span>)}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
