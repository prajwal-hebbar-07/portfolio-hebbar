---
/* Inline stroke icons (no icon library). */
const paths = {
  'arrow-right': ['M5 12h14', 'm13 6 6 6-6 6'],
  'arrow-up-right': ['M7 17 17 7', 'M8 7h9v9'],
  contrast: ['M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z', 'M12 18a6 6 0 0 0 0-12v12z'],
  download: ['M12 4v12', 'm6 10 6 6 6-6', 'M5 20h14'],
} as const;

interface Props {
  name: keyof typeof paths;
  size?: number;
}
const { name, size = 14 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {paths[name].map((d) => <path d={d} />)}
</svg>
