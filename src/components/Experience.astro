---
import { experiences } from '../data/portfolio';
---

<section id="experience" class="split">
  <h2 class="label">01 — Experience</h2>
  <div class="split-body stack-64">
    {
      experiences.map((xp) => (
        <article class="xp">
          <div class="xp-head">
            <h3>{xp.company}</h3>
            <p class="meta">{xp.when} · {xp.location}</p>
          </div>

          {xp.progression ? (
            <ol class="track" aria-label="Role progression">
              {[...xp.progression].reverse().map((step, i) => (
                <li class={i === 0 ? 'now' : ''}>
                  <span class={i === 0 ? 'role' : 'muted'}>{step.role}</span>
                  <span class="meta">{step.when}</span>
                </li>
              ))}
            </ol>
          ) : (
            <p class="role">{xp.role}</p>
          )}

          <ul class="points">
            {xp.points.map((point) => <li set:html={point} />)}
          </ul>
        </article>
      ))
    }
  </div>
</section>
