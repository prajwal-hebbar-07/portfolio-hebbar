---
import { demoForm, demoPatches } from '../../config/demo-form';
import { highlightJson } from '../../lib/json';

interface Props {
  disclaimer: string;
}

const { disclaimer } = Astro.props;
---

<div class="eng" id="engine-demo">
  <div class="pane eng-src">
    <div class="pane-head">
      <span>form.schema.json</span>
      <span class="pane-note">patch the schema:</span>
    </div>
    <div class="eng-patches">
      {
        demoPatches.map((p) => (
          <button class="patch" type="button" data-patch={p.id} aria-pressed="false">
            {p.label}
          </button>
        ))
      }
    </div>
    <pre class="json" id="eng-json" tabindex="0" set:html={highlightJson(demoForm)} />
  </div>

  <div class="pane eng-out">
    <div class="pane-head">
      <span>rendered</span>
      <span class="eng-controls">
        <span class="seg" role="group" aria-label="Persona">
          <button type="button" data-persona="maker" aria-pressed="true">maker</button>
          <button type="button" data-persona="checker" aria-pressed="false">checker</button>
        </span>
        <span class="state" id="eng-state">{demoForm.workflow.initial}</span>
        <button class="tool" type="button" id="eng-reset">reset</button>
      </span>
    </div>
    <form class="eng-form" id="eng-form" novalidate>
      <noscript>The form is rendered in the browser from the schema on the left, so it needs JavaScript.</noscript>
    </form>
    <div class="pane-head pane-head-sub"><span>engine log</span></div>
    <ol class="eng-log" id="eng-log" aria-live="polite" aria-label="Engine log"></ol>
  </div>
</div>
<p class="fine">{disclaimer}</p>
