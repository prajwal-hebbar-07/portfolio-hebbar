---
import {
  ACCENTS,
  DEFAULT_SEED,
  FONTS,
  SECTION_IDS,
  SECTION_LABELS,
} from '../data/personalize';

/* The list ships in default order and is re-sorted on boot from the saved
   record by src/scripts/personalize.ts. */
const sections = SECTION_IDS;
---

<div class="pz-scrim" id="personalize-scrim" aria-hidden="true"></div>

<aside
  class="pz"
  id="personalize"
  role="dialog"
  aria-modal="true"
  aria-labelledby="pz-title"
  aria-hidden="true"
>
  <header class="pz-head">
    <div>
      <h2 class="pz-title" id="pz-title">Personalize</h2>
      <p class="pz-sub">Yours only — saved in this browser.</p>
    </div>
    <button class="icon-btn" id="pz-close" type="button" aria-label="Close personalize panel">
      <svg class="ic" data-lucide="x"></svg>
    </button>
  </header>

  <div class="pz-body">
    <section class="pz-group">
      <h3 class="pz-legend">Appearance</h3>
      <div class="pz-seg" role="group" aria-label="Colour scheme">
        <button class="pz-seg-btn" type="button" data-theme-id="dark" aria-pressed="true">
          <svg class="ic" data-lucide="moon"></svg> Dark
        </button>
        <button class="pz-seg-btn" type="button" data-theme-id="light" aria-pressed="false">
          <svg class="ic" data-lucide="sun"></svg> Light
        </button>
      </div>
    </section>

    <section class="pz-group">
      <h3 class="pz-legend">Accent</h3>
      <div class="pz-swatches" role="group" aria-label="Accent colour">
        {
          ACCENTS.map((a) => (
            <button
              class="pz-sw"
              type="button"
              data-accent-id={a.id}
              aria-pressed="false"
              aria-label={a.label}
              title={a.label}
              style={`--sw-dark:${a.dark};--sw-light:${a.light}`}
            ></button>
          ))
        }
      </div>
      <label class="pz-custom">
        <input type="color" id="pz-custom" value={DEFAULT_SEED} aria-label="Custom accent colour" />
        <span>Custom hue</span>
      </label>
    </section>

    <section class="pz-group">
      <h3 class="pz-legend">Typeface</h3>
      <div class="pz-fonts" role="group" aria-label="Typeface">
        {
          FONTS.map((f) => (
            <button class="pz-font" type="button" data-font-id={f.id} aria-pressed="false">
              <span class={`pz-font-name pz-font-${f.id}`}>{f.label}</span>
              <span class="pz-font-note">{f.note}</span>
            </button>
          ))
        }
      </div>
    </section>

    <section class="pz-group">
      <h3 class="pz-legend">Section order</h3>
      <p class="pz-hint">Drag a row, or use the arrows.</p>
      <ul class="pz-list" id="pz-order">
        {
          sections.map((id) => (
            <li class="pz-row" data-section={id} draggable="true">
              <span class="pz-grip" aria-hidden="true">
                <svg class="ic" data-lucide="grip-vertical"></svg>
              </span>
              <span class="pz-row-name">{SECTION_LABELS[id]}</span>
              <span class="pz-row-moves">
                <button
                  class="pz-move"
                  type="button"
                  data-move="up"
                  aria-label={`Move ${SECTION_LABELS[id]} up`}
                >
                  <svg class="ic" data-lucide="chevron-up"></svg>
                </button>
                <button
                  class="pz-move"
                  type="button"
                  data-move="down"
                  aria-label={`Move ${SECTION_LABELS[id]} down`}
                >
                  <svg class="ic" data-lucide="chevron-down"></svg>
                </button>
              </span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <footer class="pz-foot">
    <button class="btn btn-secondary btn-sm" id="pz-reset" type="button">
      <svg class="ic" data-lucide="rotate-ccw"></svg> Reset to defaults
    </button>
  </footer>
</aside>
