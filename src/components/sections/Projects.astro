---
import type { Project } from '../../data/portfolio';

interface Props {
  items: Project[];
}

const { items } = Astro.props;
---

<div class="pj">
  <div class="pj-tabs" role="tablist" aria-label="Projects" aria-orientation="vertical">
    {
      items.map((project, index) => (
        <button
          type="button"
          role="tab"
          id={`pj-tab-${index}`}
          aria-controls={`pj-panel-${index}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? '0' : '-1'}
        >
          <span class="pj-tab-name">{project.name}</span>
          <span class="k">{project.status}</span>
        </button>
      ))
    }
  </div>

  <div class="pj-panels">
    {
      items.map((project, index) => (
        <article
          class="pj-panel"
          role="tabpanel"
          id={`pj-panel-${index}`}
          aria-labelledby={`pj-tab-${index}`}
          hidden={index !== 0}
        >
          <header class="pj-head">
            <h3>{project.name}</h3>
            {project.repo ? (
              <a class="link" href={project.repo} target="_blank" rel="noopener">
                {project.repoLabel} ↗
              </a>
            ) : (
              <span class="k">private repository</span>
            )}
          </header>
          <p class="pj-tagline">{project.tagline}</p>
          <p class="k">{project.kind}</p>

          {project.media && (
            <div class="pj-media">
              {project.media.map((m) => (
                <img src={m.src} alt={m.alt} loading="lazy" />
              ))}
            </div>
          )}

          <ul class="points">
            {project.points.slice(0, 2).map((point) => (
              <li set:html={point} />
            ))}
          </ul>
          {project.points.length > 2 && (
            <details class="more">
              <summary>How it's built</summary>
              <ul class="points">
                {project.points.slice(2).map((point) => (
                  <li set:html={point} />
                ))}
              </ul>
            </details>
          )}

          <ul class="tags" aria-label="Technologies used">
            {project.tech.map((technology) => (
              <li>{technology}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</div>
