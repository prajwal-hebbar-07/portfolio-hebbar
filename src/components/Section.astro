---
/* The shell every section renders in: its signature, the variant switch, the
   schema pane and the move buttons. The body is whatever component the
   registry in index.astro maps the section's `type` to. */
import type { SectionConfig } from '../config/site';
import { highlightJson } from '../lib/json';

interface Props {
  section: SectionConfig;
}

const { section } = Astro.props;
const { id, type, label, title, lede, variants } = section;
const variant = variants?.[0];
/* `variant` is added to what the pane prints because the visitor can change
   it; everything else is the config entry as written. */
const shown = variant ? { ...section, variant } : section;
---

<section class="sec" id={id} data-type={type} data-variant={variant} data-variants={variants?.join(' ')}>
  <div class="wrap">
    <header class="sec-bar">
      <code class="sec-sig"><b>{id}</b><span>: Section&lt;"{type}"&gt;</span></code>
      <div class="sec-tools">
        {
          variants && (
            <div class="seg" role="group" aria-label={`${label} layout`}>
              {variants.map((v) => (
                <button type="button" data-variant-set={v} aria-pressed={v === variant ? 'true' : 'false'}>
                  {v}
                </button>
              ))}
            </div>
          )
        }
        <button class="tool" type="button" data-schema-toggle aria-expanded="false" aria-controls={`schema-${id}`}>
          {'{ }'} schema
        </button>
        <button class="tool tool-sq" type="button" data-move="up" aria-label={`Move ${label} section up`}>↑</button>
        <button class="tool tool-sq" type="button" data-move="down" aria-label={`Move ${label} section down`}>↓</button>
      </div>
    </header>

    <div class="pane schema" id={`schema-${id}`} hidden>
      <div class="pane-head">
        <span>src/config/site.ts › sections › {id}</span>
        <span class="pane-note">this entry renders the section below</span>
      </div>
      <pre class="json" tabindex="0" set:html={highlightJson(shown, ['variant'])} />
    </div>

    <div class="sec-body">
      {
        title && (
          <div class="sec-head">
            <h2 set:html={title} />
            {lede && <p>{lede}</p>}
          </div>
        )
      }
      <slot />
    </div>
  </div>
</section>
