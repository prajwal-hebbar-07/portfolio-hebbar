---
import { profile } from '../data/portfolio';
import Icon from './Icon.astro';
---

<section id="contact" class="contact">
  <p class="label">05 — Contact</p>
  <h2>Building something that needs to work end to end? Let’s talk.</h2>
  <a class="email" href={`mailto:${profile.email}`}>
    {profile.email} <Icon name="arrow-up-right" size={22} />
  </a>
  <ul class="links">
    <li><a href={`tel:${profile.phoneHref}`}>{profile.phone}</a></li>
    <li><a href={profile.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a></li>
    <li><a href={profile.github} target="_blank" rel="noopener">GitHub ↗</a></li>
    <li><a href="/Prajwal%20Hebbar%20-%20Resume.pdf" target="_blank" rel="noopener">Résumé (PDF) ↓</a></li>
  </ul>
</section>
