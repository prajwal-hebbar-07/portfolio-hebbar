---
import { introduction } from '../../config/site';
import { profile } from '../../data/portfolio';
---
<div class="hero-grid">
  <div class="hero-copy">
    <p class="eyebrow greeting"><span class="tiny-spark" aria-hidden="true">✳</span> {introduction.greeting}</p>
    <h1>{introduction.headline}<br /><em>{introduction.accent}</em></h1>
    <p class="hero-description">{introduction.description}</p>
    <div class="hero-actions">
      <a class="button" href="#projects">Explore my work <span aria-hidden="true">↘</span></a>
      <a class="text-link" href={profile.resume} target="_blank" rel="noreferrer">Résumé <span class="file-label">PDF</span><span aria-hidden="true">↗</span></a>
    </div>
    <div class="hero-footnote"><span class="status-dot" aria-hidden="true"></span>{profile.status}<span class="footnote-divider">/</span><span>Based in Bengaluru</span></div>
  </div>
  <aside class="hello-card" aria-label="A little about me">
    <div class="hello-card-top"><span class="eyebrow">A LITTLE ABOUT ME</span><span aria-hidden="true">↗</span></div>
    <div class="orbit-art" aria-hidden="true">
      <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
      <span class="orbit-node node-one">web</span><span class="orbit-node node-two">mobile</span><span class="orbit-node node-three">desktop</span>
      <span class="orbit-center">ph<span>.</span></span><span class="art-spark">✳</span>
    </div>
    <h2>A builder at heart.<br />Full stack by trade.</h2>
    <p>Nearly five years of connecting the dots between people, products and code.</p>
    <div class="hello-card-bottom"><span class="status-dot" aria-hidden="true"></span>Currently at LYIK Technologies</div>
  </aside>
</div>
