---
import type { Generation } from '../../data/portfolio';

interface Props {
  generations: Generation[];
}

const { generations } = Astro.props;
const rows: { key: 'scope' | 'architecture' | 'access' | 'delivery'; label: string }[] = [
  { key: 'scope', label: 'scope' },
  { key: 'architecture', label: 'architecture' },
  { key: 'access', label: 'access & workflow' },
  { key: 'delivery', label: 'delivery' },
];
---

<div class="evo">
  {
    generations.map((g, i) => (
      <article class="evo-col">
        <header class="evo-head">
          <span class="evo-v">{g.version}</span>
          <span class="evo-when">{g.when}</span>
          <span class="evo-role">{g.role}</span>
        </header>
        <div class="evo-row">
          <h3 class="k">config drives</h3>
          <ul class="tags">
            {g.configDrives.map((item) => (
              <li class:list={[i > 0 && !generations[i - 1].configDrives.includes(item) && 'is-new']}>{item}</li>
            ))}
          </ul>
        </div>
        {rows.map((r) => (
          <div class="evo-row">
            <h3 class="k">{r.label}</h3>
            <p>{g[r.key]}</p>
          </div>
        ))}
      </article>
    ))
  }
</div>
<p class="fine"><span class="swatch-new" aria-hidden="true"></span> newly config-driven in that generation</p>
