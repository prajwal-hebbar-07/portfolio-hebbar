---
import { profile } from '../data/portfolio';
import Icon from './Icon.astro';

const stats = [
  { label: 'Experience', value: '~5 years' },
  { label: 'Forms platform', value: 'v1 → v3' },
  { label: 'Client efficiency', value: '30%+ gain' },
  { label: 'Scope', value: 'UI → DB → CI' },
];
---

<section id="top" class="hero">
  <p class="status">
    <span class="dot"></span>
    {profile.title} · {profile.location}
  </p>
  <h1>I build enterprise software end to end.</h1>
  <p class="lede">
    Nearly five years shipping React and TypeScript interfaces, Node.js APIs, SQL schemas,
    authentication, and the Docker and CI/CD pipelines that deliver them. Currently {profile.role}
    at <span class="ink">LYIK Technologies</span>, building the third generation of a multi-tenant
    forms platform.
  </p>
  <div class="cta">
    <a class="btn" href={`mailto:${profile.email}`}>Get in touch <Icon name="arrow-right" size={16} /></a>
    <a class="text-link" href={profile.github} target="_blank" rel="noopener">GitHub <Icon name="arrow-up-right" /></a>
    <a class="text-link" href={profile.linkedin} target="_blank" rel="noopener">LinkedIn <Icon name="arrow-up-right" /></a>
  </div>

  <dl class="stats">
    {
      stats.map((s) => (
        <div>
          <dt>{s.label}</dt>
          <dd>{s.value}</dd>
        </div>
      ))
    }
  </dl>
</section>
