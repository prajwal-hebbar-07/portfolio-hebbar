---
import { profile } from '../data/portfolio';
import { githubSvg, linkedinSvg } from '../data/brandIcons';
---

<footer class="footer">
  <div class="wrap footer-inner">
    <div class="f-brand">
      <span class="monogram" style="width:32px;height:32px;font-size:13px;border-radius:10px;" aria-hidden="true">PH</span>
      <span class="f-note">{profile.name} — {profile.role}</span>
    </div>
    <div class="f-note">Designed in the <span class="accent">Mineral</span> system · © <span id="year">2026</span> {profile.name}</div>
    <div class="f-social">
      <a class="icon-btn" href={profile.github} target="_blank" rel="noopener" aria-label="GitHub" set:html={githubSvg}></a>
      <a class="icon-btn" href={profile.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" set:html={linkedinSvg}></a>
      <a class="icon-btn" href={`mailto:${profile.email}`} aria-label="Email"><svg class="ic" data-lucide="mail"></svg></a>
    </div>
  </div>
</footer>
